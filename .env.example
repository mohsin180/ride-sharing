# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this template is committed so new contributors know what to set.

# ── Backend ────────────────────────────────────────────────────────────
# Base URL for the Spring Boot REST API (no trailing slash).
# Examples:
#   Android emulator → http://10.0.2.2:8080/api/v1
#   iOS simulator    → http://localhost:8080/api/v1
#   Physical device  → http://<your-LAN-ip>:8080/api/v1
#   Production       → https://api.your-domain.com/api/v1
API_BASE_URL=http://localhost:8080/api/v1

# ── Geoapify ───────────────────────────────────────────────────────────
# Replaces Google Maps for Autocomplete, Geocoding, and Routing.
# Sign up (free, no card): https://myprojects.geoapify.com/
# Free tier is 3,000 req/day. Restrict the key to your bundle ID in
# the Geoapify dashboard before shipping.
GEOAPIFY_API_KEY=your-geoapify-key-here
