# Copy this file to `.env` and fill in real values. `.env` is gitignored;
# this template is committed so new contributors know what to set.

# ── Backend ────────────────────────────────────────────────────────────
# Base URL for the Spring Boot REST API (no trailing slash).
# Examples:
#   Android emulator → http://10.0.2.2:8080/api/v1
#   iOS simulator    → http://localhost:8080/api/v1
#   Physical device  → http://<your-LAN-ip>:8080/api/v1
#   Production       → https://api.your-domain.com/api/v1
API_BASE_URL=http://localhost:8080/api/v1

# ── Google Maps ────────────────────────────────────────────────────────
# Used for Directions, Geocoding, Places HTTP APIs.
# Restrict the key in Google Cloud Console to your app's bundle ID and
# enable only the APIs you need — bundled assets are extractable from
# the APK/IPA, so the key is only as safe as its restrictions.
GOOGLE_MAPS_KEY=your-google-maps-key-here
