# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code. Ignored here because launch.json holds the GOOGLE_MAPS_KEY
# dart-define value, which must not land in source control.
.vscode/

# Local environment files — hold API keys and secrets. Never commit.
# `.env.example` is committed so contributors know which keys are required.
.env
.env.local
.env.*.local

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release
